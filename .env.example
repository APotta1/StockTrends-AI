# Copy to backend/.env and fill in to run with LIVE data.
# Leave DEMO_MODE=true (or omit everything) to run fully offline.

DEMO_MODE=false

# SEC EDGAR requires a descriptive User-Agent naming a REAL email, or it returns
# 403 and can block your IP for ~10 minutes. No API key needed otherwise.
SEC_USER_AGENT=YourName YourApp your.email@example.com

# Finnhub free tier (https://finnhub.io) — 60 req/min. Optional.
FINNHUB_API_KEY=

# Anthropic — needed only for real extraction + the eval sweep.
ANTHROPIC_API_KEY=

# CORS origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=*
